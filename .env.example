# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=walkie_talkie
DB_CONNECTION_LIMIT=10

# Security
COOKIE_SECRET=change_me_to_a_secure_random_string

# Mediasoup / WebRTC Configuration
# In production, set ANNOUNCED_IP to your public IPv4 address
ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=10000
RTC_MAX_PORT=20000

# STUN / TURN configuration (Optional, fallback provided)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
