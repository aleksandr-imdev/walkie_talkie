<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Волки Толки</title>
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>
    <div class="header">
        <div>
            <button onclick="window.history.back()">◁</button>
            <h3>Создать эфир</h3>
            <button>Сменить тему</button>
        </div>
    </div>
    <div>
        <h1><%= name %></h1>
        <h3>Эфир #<%= streamId %>></h3>
        <a id="see-user-list">online</a>
        <button id="talk-button">Говорить</button>
        <h3>Ограничение: <%= messageDuration %> сек</h3>
        <audio id="remote-audio" autoplay playsinline></audio>
        <audio id="local-audio" autoplay playsinline muted></audio>
    </div>
    <!--Поле со списком пользователей-->
    <div id="see-users-modal" style="position: absolute; width: 100%; height: 100%; top: 0; left: 0; background-color: white; display: none;">
        <div class="header">
            <div>
                <button onclick="document.getElementById('see-users-modal').style.display = 'none';">◁</button>
                <h3>Создать эфир</h3>
                <button>Сменить тему</button>
            </div>
        </div>
        <ul id="user-list">
            <!--Здесь будут отображаться пользователи-->
        </ul>
    </div>

    <!--Скрипт показа пользователей эфира-->
    <script>
        const GET_STREAM_PARTICIPANTS_API = '/api/getstreamparticipants';
        const userList = document.getElementById('user-list');
        const seeUserListButton = document.getElementById('see-user-list');
        const streamId = Number('<%= streamId %>');

        seeUserListButton.addEventListener('click', async (event) => {
            document.getElementById('see-users-modal').style.display = 'block';
            getStreamPaticipants();
        });

        async function getStreamPaticipants() {
            // Запрос участников с сервера
            const response = await fetch(`${GET_STREAM_PARTICIPANTS_API}?id=${streamId}`);
            if (!response.ok) {
                throw new Error('Ошибка загрузки данных');
                userList.innerHTML = '<p>Не удалось загрузить пользователей</p>';
            }

            const users = await response.json();

            // Вывод на страницу
            users.forEach(user => {
                const li = document.createElement('li');

                li.innerText = user.username;
                userList.appendChild(li);
            });
        }
    </script>
    <script src="/client.js"></script>
</body>
</html>
